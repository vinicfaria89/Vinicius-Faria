# Copie este arquivo para ".env" e ajuste os valores (não versionar o ".env" com senha real).

# Porta em que o servidor escuta.
PORT=4321

# Login compartilhado do time — se as duas variáveis abaixo estiverem definidas, o app inteiro
# passa a exigir autenticação HTTP Basic (usuário/senha) antes de qualquer acesso. Deixe em branco
# / não defina para rodar sem login (uso local, na sua máquina).
BASIC_AUTH_USER=
BASIC_AUTH_PASS=

# Em produção (servidor compartilhado), define NODE_ENV=production — isso desativa a cópia
# automática do PDF para a pasta "Simulação" local (que só existe na máquina do desenvolvedor).
NODE_ENV=production
